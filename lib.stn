// datetime: dates, times, durations, and UTC offsets for stone.
//
// The types follow java.time and Rust's chrono, one type per kind of value:
//
//   Date            a calendar date, such as 2026-11-06
//   Time            a time of day, such as 19:13:31.5
//   DateTime        a date and a time of day, with no offset or zone
//   Offset          a fixed offset from UTC, such as +05:30
//   OffsetDateTime  a date and time at an offset, which is one instant
//   Instant         a point in time, counted from 1970-01-01T00:00:00Z
//   TimeZone        a zone of the IANA database, such as America/Chicago, or a fixed offset
//   ZonedDateTime   a date and time in a time zone, which is one instant
//   Duration        an exact length of time, in seconds and nanoseconds
//   Period          a length in calendar units: years, months, and days
//   Weekday         Monday to Sunday
//
// Dates use the proleptic Gregorian calendar with year 0 (1 BC), for years -999999 to 999999.
// Times have nanosecond precision and no leap seconds.
//
// Arithmetic uses the operators: `date + Period.of_months(1)`, `instant - Duration.of_hours(2)`,
// `d * 3`, and `-d`.
//
// Functions that build a value from parts or text return a `result`, with an error message if
// the parts are invalid. Arithmetic that would leave the supported years, and a format pattern
// with an unknown specifier, stop the program, as an index out of range does.

use os
use time
use internal.civil
use internal.text
use internal.fmt
use internal.parse
use internal.tz

// ---------------------------------------------------------------------------------------------
// Limits and helpers

const ns = 1_000_000_000

const min_year = -999_999

const max_year = 999_999

// The days from 1970-01-01 to -999999-01-01 and to 999999-12-31.
const min_epoch_days = -365_961_662

const max_epoch_days = 364_522_971

// The seconds from 1970-01-01T00:00:00 to -999999-01-01T00:00:00 and to 999999-12-31T23:59:59.
const min_unix_seconds = -31_619_087_596_800

const max_unix_seconds = 31_494_784_780_799

// 2^62 - 1: about 146 billion years, so two durations always add without overflowing an int.
const max_duration_seconds = (1 << 62) - 1

fn add_exact(a: int, b: int, what: str) -> int:
    match civil.checked_add(a, b):
        case some(r):
            ret r
        case none:
            assert false, "datetime: {what} overflowed"
            ret 0

fn mul_exact(a: int, b: int, what: str) -> int:
    match civil.checked_mul(a, b):
        case some(r):
            ret r
        case none:
            assert false, "datetime: {what} overflowed"
            ret 0

// `r` with `what: ` in front of its error.
fn context[T](r: result[T, str], what: str) -> result[T, str]:
    match r:
        case ok(v):
            ret ok(v)
        case err(e):
            ret err("{what}: {e}")

fn chain(c: ordering, a: int, b: int) -> ordering:
    if c != equal:
        ret c
    ret a.cmp(b)

fn date_parts(d: Date) -> option[tuple[int, int, int]]:
    ret some((d.year, d.month, d.day))

fn time_parts(t: Time) -> option[tuple[int, int, int, int]]:
    ret some((t.hour, t.minute, t.second, t.nanosecond))

fn format_or_stop(f: fmt.Fields, pattern: str) -> str:
    match fmt.strftime(f, pattern):
        case ok(s):
            ret s
        case err(e):
            assert false, "datetime: {e}"
            ret ""

// ---------------------------------------------------------------------------------------------
// Calendar facts

// Whether `year` has a February 29: every fourth year, except centuries not divisible by 400.
pub fn is_leap_year(year: int) -> bool:
    ret civil.is_leap_year(year)

// The days in `year`: 365, or 366 in a leap year.
pub fn days_in_year(year: int) -> int:
    ret civil.days_in_year(year)

// The days in `month` (1 to 12) of `year`. It stops the program for a month out of range.
pub fn days_in_month(year: int, month: int) -> int:
    assert month >= 1 and month <= 12, "datetime: month {month} is out of range (1 to 12)"
    ret civil.days_in_month(year, month)

// ---------------------------------------------------------------------------------------------
// Weekday

pub enum Weekday:
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday

// The ISO 8601 number of a weekday: 1 for Monday through 7 for Sunday.
pub fn weekday_number(w: Weekday) -> int:
    match w:
        case Weekday.Monday:
            ret 1
        case Weekday.Tuesday:
            ret 2
        case Weekday.Wednesday:
            ret 3
        case Weekday.Thursday:
            ret 4
        case Weekday.Friday:
            ret 5
        case Weekday.Saturday:
            ret 6
        case Weekday.Sunday:
            ret 7

// The weekday with ISO 8601 number `n`, 1 for Monday through 7 for Sunday.
pub fn weekday_from_number(n: int) -> result[Weekday, str]:
    if n < 1 or n > 7:
        ret err("weekday {n} is out of range (1 to 7)")
    ret ok(weekday_of(n))

// The English name of a weekday, as "Monday".
pub fn weekday_name(w: Weekday) -> str:
    ret text.weekday_name(weekday_number(w))

fn weekday_of(n: int) -> Weekday:
    match n:
        case 1:
            ret Weekday.Monday
        case 2:
            ret Weekday.Tuesday
        case 3:
            ret Weekday.Wednesday
        case 4:
            ret Weekday.Thursday
        case 5:
            ret Weekday.Friday
        case 6:
            ret Weekday.Saturday
        case _:
            ret Weekday.Sunday

// ---------------------------------------------------------------------------------------------
// Duration

// An exact length of time, which may be negative. It is `secs` seconds plus `nanos`
// nanoseconds, with `nanos` from 0 to 999999999, so -1.5 seconds is secs -2 and nanos
// 500000000. Durations reach about 146 billion years either way.
pub struct Duration:
    secs: int
    nanos: int

// The duration of `secs` seconds plus `nanos` nanoseconds, for any `nanos`.
fn duration(secs: int, nanos: int) -> Duration:
    s = add_exact(secs, civil.floor_div(nanos, ns), "duration")
    assert s >= -max_duration_seconds - 1 and s <= max_duration_seconds, "datetime: duration of {s} seconds is out of range"
    ret Duration(secs=s, nanos=civil.floor_mod(nanos, ns))

// The largest `q` below 1e9 with `q * k <= r * 1e9 + n`, for `0 <= r < k`, without overflowing.
fn long_quotient(r: int, n: int, k: int) -> int:
    kh = k / ns
    kl = k % ns
    lo = 0
    hi = ns - 1
    while lo < hi:
        mid = (lo + hi + 1) / 2
        low_part = mid * kl
        high_part = mid * kh + low_part / ns
        low_part = low_part % ns
        if high_part < r or (high_part == r and low_part <= n):
            lo = mid
        else:
            hi = mid - 1
    ret lo

// Truncates toward zero to whole `unit`s of nanoseconds, for a unit below a second.
fn whole_units(d: Duration, unit: int) -> int:
    v = add_exact(mul_exact(d.secs, ns / unit, "duration"), d.nanos / unit, "duration")
    if d.secs < 0 and d.nanos % unit != 0:
        v += 1
    ret v

impl Duration:
    fn zero() -> Duration:
        ret Duration(secs=0, nanos=0)

    // A day is exactly 24 hours.
    fn of_days(n: int) -> Duration:
        ret duration(mul_exact(n, 86400, "duration"), 0)

    fn of_hours(n: int) -> Duration:
        ret duration(mul_exact(n, 3600, "duration"), 0)

    fn of_minutes(n: int) -> Duration:
        ret duration(mul_exact(n, 60, "duration"), 0)

    fn of_seconds(n: int) -> Duration:
        ret duration(n, 0)

    fn of_millis(n: int) -> Duration:
        ret duration(civil.floor_div(n, 1000), civil.floor_mod(n, 1000) * 1_000_000)

    fn of_micros(n: int) -> Duration:
        ret duration(civil.floor_div(n, 1_000_000), civil.floor_mod(n, 1_000_000) * 1000)

    fn of_nanos(n: int) -> Duration:
        ret duration(civil.floor_div(n, ns), civil.floor_mod(n, ns))

    // The duration of `x` seconds, to the nanosecond below. It stops the program for nan, an
    // infinity, or a length out of range.
    fn of_seconds_float(x: float) -> Duration:
        assert x == x and x > -4.0e18 and x < 4.0e18, "datetime: {x} seconds is out of range for a duration"
        s = x.floor()
        ret duration(s, int((x - float(s)) * 1_000_000_000.0).unwrap())

    fn is_zero(self) -> bool:
        ret self.secs == 0 and self.nanos == 0

    fn is_negative(self) -> bool:
        ret self.secs < 0

    fn abs(self) -> Duration:
        if self.is_negative():
            ret -self
        ret self

    // Whole units in the duration, truncated toward zero, so -90 seconds is -1 minute.
    fn whole_days(self) -> int:
        ret self.whole_seconds() / 86400

    fn whole_hours(self) -> int:
        ret self.whole_seconds() / 3600

    fn whole_minutes(self) -> int:
        ret self.whole_seconds() / 60

    fn whole_seconds(self) -> int:
        if self.secs < 0 and self.nanos > 0:
            ret self.secs + 1
        ret self.secs

    fn whole_millis(self) -> int:
        ret whole_units(self, 1_000_000)

    fn whole_micros(self) -> int:
        ret whole_units(self, 1000)

    // The duration in nanoseconds. It stops the program for one longer than about 292 years.
    fn whole_nanos(self) -> int:
        ret whole_units(self, 1)

    // The duration in seconds as a float, which rounds durations past about 104 days to less
    // than a nanosecond.
    fn as_seconds_float(self) -> float:
        ret float(self.secs) + float(self.nanos) / 1_000_000_000.0

    // Reads an ISO 8601 duration of days, hours, minutes, and seconds, such as "PT1H30M",
    // "P2DT0.5S", or "-PT10S". A day is 24 hours. Years and months belong to a Period.
    fn parse_iso(input: str) -> result[Duration, str]:
        secs, nanos = context(parse.iso_duration(input), "cannot parse '{input}' as an ISO 8601 duration")?
        ret ok(Duration(secs=secs, nanos=nanos))

// `a + b`, `a - b`, and `-a` are exact.
impl add[Duration] for Duration:
    fn add(self, other: Duration) -> Self:
        ret duration(self.secs + other.secs, self.nanos + other.nanos)

impl sub[Duration] for Duration:
    fn sub(self, other: Duration) -> Self:
        ret self + -other

impl neg for Duration:
    fn neg(self) -> Self:
        if self.nanos == 0:
            ret duration(-self.secs, 0)
        ret duration(-self.secs - 1, ns - self.nanos)

// The duration `k` times as long, exactly.
impl mul[int] for Duration:
    fn mul(self, k: int) -> Self:
        kh = civil.floor_div(k, ns)
        kl = civil.floor_mod(k, ns)
        low = self.nanos * kl
        s = add_exact(mul_exact(self.secs, k, "duration"), mul_exact(self.nanos, kh, "duration"), "duration")
        ret duration(add_exact(s, low / ns, "duration"), low % ns)

// The duration divided by `k`, truncated toward zero to the nanosecond, exactly.
impl div[int] for Duration:
    fn div(self, k: int) -> Self:
        assert k != 0, "datetime: duration divided by zero"
        if k == -9_223_372_036_854_775_807 - 1:
            ret self / -2 / 4_611_686_018_427_387_904
        negative = self.is_negative() != (k < 0)
        m = self.abs()
        kk = k.abs()
        qs = m.secs / kk
        r = m.secs % kk
        qn = 0
        if r <= 9223372035:
            qn = (r * ns + m.nanos) / kk
        else:
            qn = long_quotient(r, m.nanos, kk)
        q = duration(qs, qn)
        if negative:
            ret -q
        ret q

impl ord for Duration:
    fn cmp(self, other: Duration) -> ordering:
        ret chain(self.secs.cmp(other.secs), self.nanos, other.nanos)

// ISO 8601, in hours, minutes, and seconds: "PT1H30M", "PT0.5S", "-PT36H", "PT0S".
impl display for Duration:
    fn display(self) -> str:
        if self.is_zero():
            ret "PT0S"
        out = "PT"
        d = self
        if self.is_negative():
            out = "-PT"
            d = -self
        s = d.secs
        if s >= 3600:
            out += "{s / 3600}H"
        if s / 60 % 60 != 0:
            out += "{s / 60 % 60}M"
        if s % 60 != 0 or d.nanos != 0:
            out += "{s % 60}{text.short_fraction_text(d.nanos)}S"
        ret out

// ---------------------------------------------------------------------------------------------
// Period

// A length in calendar units, whose exact length depends on the date it is added to: a month
// from January 31 ends on February 28 or 29. Each part may be negative.
pub struct Period:
    years: int
    months: int
    days: int

impl Period:
    fn of(years: int, months: int, days: int) -> Period:
        ret Period(years=years, months=months, days=days)

    fn zero() -> Period:
        ret Period(years=0, months=0, days=0)

    fn of_years(n: int) -> Period:
        ret Period(years=n, months=0, days=0)

    fn of_months(n: int) -> Period:
        ret Period(years=0, months=n, days=0)

    fn of_weeks(n: int) -> Period:
        ret Period(years=0, months=0, days=mul_exact(n, 7, "period"))

    fn of_days(n: int) -> Period:
        ret Period(years=0, months=0, days=n)

    fn is_zero(self) -> bool:
        ret self.years == 0 and self.months == 0 and self.days == 0

    // Reads an ISO 8601 period such as "P1Y2M3D", "P2W", "-P1M", or "P1Y-2M". A week is 7 days.
    fn parse_iso(input: str) -> result[Period, str]:
        y, m, d = context(parse.iso_period(input), "cannot parse '{input}' as an ISO 8601 period")?
        ret ok(Period(years=y, months=m, days=d))

// Adds the parts, without carrying months into years.
impl add[Period] for Period:
    fn add(self, other: Period) -> Self:
        ret Period(years=add_exact(self.years, other.years, "period"), months=add_exact(self.months, other.months, "period"), days=add_exact(self.days, other.days, "period"))

impl sub[Period] for Period:
    fn sub(self, other: Period) -> Self:
        ret self + -other

impl neg for Period:
    fn neg(self) -> Self:
        ret Period(years=mul_exact(self.years, -1, "period"), months=mul_exact(self.months, -1, "period"), days=mul_exact(self.days, -1, "period"))

// Each part `k` times as large.
impl mul[int] for Period:
    fn mul(self, k: int) -> Self:
        ret Period(years=mul_exact(self.years, k, "period"), months=mul_exact(self.months, k, "period"), days=mul_exact(self.days, k, "period"))

// ISO 8601: "P1Y2M3D", with zero parts left out, and "P0D" for no time at all.
impl display for Period:
    fn display(self) -> str:
        if self.is_zero():
            ret "P0D"
        out = "P"
        if self.years != 0:
            out += "{self.years}Y"
        if self.months != 0:
            out += "{self.months}M"
        if self.days != 0:
            out += "{self.days}D"
        ret out

// ---------------------------------------------------------------------------------------------
// Offset

// A fixed offset from UTC, from -18:00 to +18:00, positive east of Greenwich.
pub struct Offset:
    seconds: int

impl Offset:
    fn utc() -> Offset:
        ret Offset(seconds=0)

    fn of_seconds(seconds: int) -> result[Offset, str]:
        if seconds < -64800 or seconds > 64800:
            ret err("offset of {seconds} seconds is out of range (-18:00 to +18:00)")
        ret ok(Offset(seconds=seconds))

    fn of_hours(hours: int) -> result[Offset, str]:
        if hours < -18 or hours > 18:
            ret err("offset of {hours} hours is out of range (-18 to 18)")
        ret ok(Offset(seconds=hours * 3600))

    // The offset of `hours` and `minutes`, both toward the sign of `hours`: `of_hm(-3, 30)` is
    // -03:30. Use `of_seconds(-1800)` for -00:30.
    fn of_hm(hours: int, minutes: int) -> result[Offset, str]:
        if minutes < 0 or minutes > 59:
            ret err("offset minutes {minutes} is out of range (0 to 59)")
        if hours < -18 or hours > 18:
            ret err("offset of {hours} hours is out of range (-18 to 18)")
        if hours < 0:
            ret Offset.of_seconds(hours * 3600 - minutes * 60)
        ret Offset.of_seconds(hours * 3600 + minutes * 60)

    // Reads "Z", "+05:30", "+0530", "+05", or "-01:02:03".
    fn parse_iso(input: str) -> result[Offset, str]:
        ret context(offset_iso(input), "cannot parse '{input}' as an ISO 8601 offset")

fn offset_iso(input: str) -> result[Offset, str]:
    cs = text.chars(input)
    s, j = parse.iso_offset(cs, 0)?
    parse.iso_end(cs, j)?
    ret Offset.of_seconds(s)

impl ord for Offset:
    fn cmp(self, other: Offset) -> ordering:
        ret self.seconds.cmp(other.seconds)

// "Z" for UTC, and otherwise "+05:30", or "+05:30:15" for an offset with seconds.
impl display for Offset:
    fn display(self) -> str:
        if self.seconds == 0:
            ret "Z"
        ret text.offset_text(self.seconds, true)

// ---------------------------------------------------------------------------------------------
// Date

// A date in the proleptic Gregorian calendar, with no time of day or offset.
pub struct Date:
    year: int
    month: int
    day: int

impl Date:
    // The date `year`-`month`-`day`, or an error if there is no such date.
    fn of(year: int, month: int, day: int) -> result[Date, str]:
        if year < min_year or year > max_year:
            ret err("year {year} is out of range (-999999 to 999999)")
        if month < 1 or month > 12:
            ret err("month {month} is out of range (1 to 12)")
        n = civil.days_in_month(year, month)
        if day < 1 or day > n:
            ret err("day {day} is out of range for {text.year_text(year)}-{month:02} (1 to {n})")
        ret ok(Date(year=year, month=month, day=day))

    // The `day_of_year`th day of `year`, counting January 1 as 1.
    fn from_ordinal(year: int, day_of_year: int) -> result[Date, str]:
        if year < min_year or year > max_year:
            ret err("year {year} is out of range (-999999 to 999999)")
        n = civil.days_in_year(year)
        if day_of_year < 1 or day_of_year > n:
            ret err("day of year {day_of_year} is out of range for {text.year_text(year)} (1 to {n})")
        ret ok(Date.from_epoch_days(civil.days_from_civil(year, 1, 1) + day_of_year - 1))

    // The `weekday` of ISO 8601 week `week` of the week-based year `iso_year`.
    fn from_iso_week(iso_year: int, week: int, weekday: Weekday) -> result[Date, str]:
        if iso_year < min_year + 1 or iso_year > max_year - 1:
            ret err("ISO year {iso_year} is out of range (-999998 to 999998)")
        n = civil.iso_weeks_in_year(iso_year)
        if week < 1 or week > n:
            ret err("week {week} is out of range for {text.year_text(iso_year)} (1 to {n})")
        ret ok(Date.from_epoch_days(civil.days_from_iso_week(iso_year, week, weekday_number(weekday))))

    // The date `days` days after 1970-01-01.
    fn from_epoch_days(days: int) -> Date:
        assert days >= min_epoch_days and days <= max_epoch_days, "datetime: date {days} days from 1970-01-01 is outside the supported years (-999999 to 999999)"
        y, m, d = civil.civil_from_days(days)
        ret Date(year=y, month=m, day=d)

    // Today's date in UTC.
    fn today_utc() -> Date:
        ret Instant.now().to_utc().datetime.date

    // Today's date in `zone`.
    fn today(zone: TimeZone) -> Date:
        ret ZonedDateTime.now(zone).datetime.date

    // The days from 1970-01-01 to this date, negative before it.
    fn to_epoch_days(self) -> int:
        ret civil.days_from_civil(self.year, self.month, self.day)

    fn weekday(self) -> Weekday:
        ret weekday_of(civil.weekday_from_days(self.to_epoch_days()))

    // The day of the year, 1 for January 1.
    fn day_of_year(self) -> int:
        ret civil.day_of_year(self.year, self.month, self.day)

    // The ISO 8601 (week-based year, week number). Week 1 holds the year's first Thursday, so
    // 2021-01-03 is in week 53 of 2020.
    fn iso_week(self) -> tuple[int, int]:
        ret civil.iso_week(self.year, self.month, self.day)

    fn is_leap_year(self) -> bool:
        ret civil.is_leap_year(self.year)

    fn days_in_month(self) -> int:
        ret civil.days_in_month(self.year, self.month)

    fn days_in_year(self) -> int:
        ret civil.days_in_year(self.year)

    fn first_of_month(self) -> Date:
        ret Date(year=self.year, month=self.month, day=1)

    fn last_of_month(self) -> Date:
        ret Date(year=self.year, month=self.month, day=self.days_in_month())

    fn add_days(self, n: int) -> Date:
        ret Date.from_epoch_days(add_exact(self.to_epoch_days(), n, "date"))

    fn add_weeks(self, n: int) -> Date:
        ret self.add_days(mul_exact(n, 7, "date"))

    // The date `n` months later, or earlier for a negative `n`, on the same day of the month
    // or the month's last day if it is shorter: 2026-01-31 plus 1 month is 2026-02-28.
    fn add_months(self, n: int) -> Date:
        total = add_exact(self.year * 12 + self.month - 1, n, "date")
        y = civil.floor_div(total, 12)
        m = civil.floor_mod(total, 12) + 1
        assert y >= min_year and y <= max_year, "datetime: year {y} is outside the supported years (-999999 to 999999)"
        d = self.day
        if d > civil.days_in_month(y, m):
            d = civil.days_in_month(y, m)
        ret Date(year=y, month=m, day=d)

    // The date `n` years later, with February 29 becoming February 28 in a common year.
    fn add_years(self, n: int) -> Date:
        ret self.add_months(mul_exact(n, 12, "date"))

    // The days from this date to `other`, negative if `other` is earlier.
    fn days_until(self, other: Date) -> int:
        ret other.to_epoch_days() - self.to_epoch_days()

    // This date at time of day `t`.
    fn at(self, t: Time) -> DateTime:
        ret DateTime(date=self, time=t)

    // Writes the date as `pattern` says, as `format("%d %B %Y")` gives "06 November 2026".
    // See the README for the specifiers. A time or offset specifier stops the program.
    fn format(self, pattern: str) -> str:
        ret format_or_stop(fmt.Fields(kind="Date", date=date_parts(self), time=none, offset=none, zone=none), pattern)

    // Reads a date written as `pattern` says, such as `Date.parse("06/11/2026", "%d/%m/%Y")`.
    fn parse(input: str, pattern: str) -> result[Date, str]:
        ret context(date_parse(input, pattern), "cannot parse '{input}' with '{pattern}'")

    // Reads an ISO 8601 date: "2026-11-06", or "+012026-11-06" and "-0044-03-15" with a sign.
    fn parse_iso(input: str) -> result[Date, str]:
        ret context(date_iso(input), "cannot parse '{input}' as an ISO 8601 date")

fn date_parse(input: str, pattern: str) -> result[Date, str]:
    p = parse.strptime(input, pattern)?
    match parse.resolve_date(p)?:
        case some(ymd):
            y, m, d = ymd
            ret Date.of(y, m, d)
        case none:
            ret err("the pattern reads no date")

fn date_iso(input: str) -> result[Date, str]:
    cs = text.chars(input)
    y, m, d, j = parse.iso_date(cs, 0)?
    parse.iso_end(cs, j)?
    ret Date.of(y, m, d)

// `d + p` adds the years and months of `p` first, then its days, so 2026-01-31 + P1M1D is
// 2026-03-01. `d - p` adds `-p`.
impl add[Period] for Date:
    fn add(self, p: Period) -> Self:
        months = add_exact(mul_exact(p.years, 12, "date"), p.months, "date")
        ret self.add_months(months).add_days(p.days)

impl sub[Period] for Date:
    fn sub(self, p: Period) -> Self:
        ret self + -p

impl ord for Date:
    fn cmp(self, other: Date) -> ordering:
        ret chain(chain(self.year.cmp(other.year), self.month, other.month), self.day, other.day)

// ISO 8601: "2026-11-06".
impl display for Date:
    fn display(self) -> str:
        ret "{text.year_text(self.year)}-{self.month:02}-{self.day:02}"

// ---------------------------------------------------------------------------------------------
// Time

// A time of day from 00:00:00 to 23:59:59.999999999, with no date or offset.
pub struct Time:
    hour: int
    minute: int
    second: int
    nanosecond: int

fn time_from_nanos(n: int) -> Time:
    s = n / ns
    ret Time(hour=s / 3600, minute=s / 60 % 60, second=s % 60, nanosecond=n % ns)

impl Time:
    fn of(hour: int, minute: int, second: int) -> result[Time, str]:
        ret Time.of_nanos(hour, minute, second, 0)

    fn of_nanos(hour: int, minute: int, second: int, nanosecond: int) -> result[Time, str]:
        if hour < 0 or hour > 23:
            ret err("hour {hour} is out of range (0 to 23)")
        if minute < 0 or minute > 59:
            ret err("minute {minute} is out of range (0 to 59)")
        if second < 0 or second > 59:
            ret err("second {second} is out of range (0 to 59)")
        if nanosecond < 0 or nanosecond > 999_999_999:
            ret err("nanosecond {nanosecond} is out of range (0 to 999999999)")
        ret ok(Time(hour=hour, minute=minute, second=second, nanosecond=nanosecond))

    fn midnight() -> Time:
        ret Time(hour=0, minute=0, second=0, nanosecond=0)

    fn noon() -> Time:
        ret Time(hour=12, minute=0, second=0, nanosecond=0)

    // The time `seconds` after midnight, from 0 to 86399.
    fn from_seconds_of_day(seconds: int) -> result[Time, str]:
        if seconds < 0 or seconds >= 86400:
            ret err("{seconds} seconds is out of range for a time of day (0 to 86399)")
        ret ok(time_from_nanos(seconds * ns))

    // The time `nanos` after midnight, from 0 to 86399999999999.
    fn from_nanos_of_day(nanos: int) -> result[Time, str]:
        if nanos < 0 or nanos >= 86400 * ns:
            ret err("{nanos} nanoseconds is out of range for a time of day (0 to 86399999999999)")
        ret ok(time_from_nanos(nanos))

    fn seconds_of_day(self) -> int:
        ret self.hour * 3600 + self.minute * 60 + self.second

    fn nanos_of_day(self) -> int:
        ret self.seconds_of_day() * ns + self.nanosecond

    // The duration from this time to `other` on the same day, negative if `other` is earlier.
    fn duration_until(self, other: Time) -> Duration:
        ret Duration.of_nanos(other.nanos_of_day() - self.nanos_of_day())

    // Writes the time as `pattern` says, as `format("%I:%M %p")` gives "07:13 PM". A date or
    // offset specifier stops the program.
    fn format(self, pattern: str) -> str:
        ret format_or_stop(fmt.Fields(kind="Time", date=none, time=time_parts(self), offset=none, zone=none), pattern)

    // Reads a time written as `pattern` says. Minutes and seconds left out are 0.
    fn parse(input: str, pattern: str) -> result[Time, str]:
        ret context(time_parse(input, pattern), "cannot parse '{input}' with '{pattern}'")

    // Reads an ISO 8601 time: "19:13", "19:13:31", or "19:13:31.5". Leap seconds are not read.
    fn parse_iso(input: str) -> result[Time, str]:
        ret context(time_iso(input), "cannot parse '{input}' as an ISO 8601 time")

fn time_parse(input: str, pattern: str) -> result[Time, str]:
    p = parse.strptime(input, pattern)?
    match parse.resolve_time(p)?:
        case some(hmsn):
            h, m, s, n = hmsn
            ret Time.of_nanos(h, m, s, n)
        case none:
            ret err("the pattern reads no time of day")

fn time_iso(input: str) -> result[Time, str]:
    cs = text.chars(input)
    h, m, s, n, j = parse.iso_time(cs, 0)?
    parse.iso_end(cs, j)?
    ret Time.of_nanos(h, m, s, n)

// `t + d` is the time `d` later, going around midnight as a clock does.
impl add[Duration] for Time:
    fn add(self, d: Duration) -> Self:
        n = civil.floor_mod(d.secs, 86400) * ns + d.nanos + self.nanos_of_day()
        ret time_from_nanos(civil.floor_mod(n, 86400 * ns))

impl sub[Duration] for Time:
    fn sub(self, d: Duration) -> Self:
        ret self + -d

impl ord for Time:
    fn cmp(self, other: Time) -> ordering:
        ret self.nanos_of_day().cmp(other.nanos_of_day())

// ISO 8601: "19:13:31", with a fraction of 3, 6, or 9 digits if needed, as "19:13:31.500".
impl display for Time:
    fn display(self) -> str:
        ret "{self.hour:02}:{self.minute:02}:{self.second:02}{text.fraction_text(self.nanosecond)}"

// ---------------------------------------------------------------------------------------------
// DateTime

// A date and time of day with no offset, as a wall clock shows. It names no single instant
// until it is given an offset, with `at_offset`, or taken as UTC, with `assume_utc`.
pub struct DateTime:
    date: Date
    time: Time

// The seconds from 1970-01-01T00:00:00 to the date and time, ignoring nanoseconds.
fn local_seconds(dt: DateTime) -> int:
    ret dt.date.to_epoch_days() * 86400 + dt.time.seconds_of_day()

fn datetime_from_local(secs: int, nanos: int) -> DateTime:
    s = add_exact(secs, civil.floor_div(nanos, ns), "date and time")
    days = civil.floor_div(s, 86400)
    n = civil.floor_mod(s, 86400) * ns + civil.floor_mod(nanos, ns)
    ret DateTime(date=Date.from_epoch_days(days), time=time_from_nanos(n))

impl DateTime:
    fn of(year: int, month: int, day: int, hour: int, minute: int, second: int) -> result[DateTime, str]:
        d = Date.of(year, month, day)?
        t = Time.of(hour, minute, second)?
        ret ok(DateTime(date=d, time=t))

    fn new(date: Date, time: Time) -> DateTime:
        ret DateTime(date=date, time=time)

    // The date and time now in UTC.
    fn now_utc() -> DateTime:
        ret Instant.now().to_utc().datetime

    // The date and time now on the clocks of `zone`.
    fn now(zone: TimeZone) -> DateTime:
        ret ZonedDateTime.now(zone).datetime

    fn add_days(self, n: int) -> DateTime:
        ret DateTime(date=self.date.add_days(n), time=self.time)

    // The duration from this date and time to `other`, negative if `other` is earlier.
    fn duration_until(self, other: DateTime) -> Duration:
        ret duration(local_seconds(other) - local_seconds(self), other.time.nanosecond - self.time.nanosecond)

    fn at_offset(self, offset: Offset) -> OffsetDateTime:
        ret OffsetDateTime(datetime=self, offset=offset)

    // The instant this date and time names in UTC.
    fn assume_utc(self) -> Instant:
        ret instant(local_seconds(self), self.time.nanosecond)

    // This date and time on the clocks of `zone`. A time the clocks skip moves later by the
    // length of the gap, and a time they show twice is the earlier instant, as
    // `ZonedDateTime.new` says.
    fn in_zone(self, zone: TimeZone) -> ZonedDateTime:
        ret ZonedDateTime.new(self, zone)

    // Writes the date and time as `pattern` says. An offset specifier stops the program.
    fn format(self, pattern: str) -> str:
        ret format_or_stop(fmt.Fields(kind="DateTime", date=date_parts(self.date), time=time_parts(self.time), offset=none, zone=none), pattern)

    // Reads a date and time written as `pattern` says. The pattern must read both.
    fn parse(input: str, pattern: str) -> result[DateTime, str]:
        ret context(datetime_parse(input, pattern), "cannot parse '{input}' with '{pattern}'")

    // Reads an ISO 8601 date and time, as "2026-11-06T19:13:31", with `T`, `t`, or a space
    // between them.
    fn parse_iso(input: str) -> result[DateTime, str]:
        ret context(datetime_iso(input), "cannot parse '{input}' as an ISO 8601 date and time")

fn datetime_parse(input: str, pattern: str) -> result[DateTime, str]:
    p = parse.strptime(input, pattern)?
    date = parse.resolve_date(p)?
    tm = parse.resolve_time(p)?
    if date.is_none():
        ret err("the pattern reads no date")
    if tm.is_none():
        ret err("the pattern reads no time of day")
    y, mo, d = date.unwrap()
    h, mi, s, n = tm.unwrap()
    ret ok(DateTime(date=Date.of(y, mo, d)?, time=Time.of_nanos(h, mi, s, n)?))

fn datetime_iso(input: str) -> result[DateTime, str]:
    cs = text.chars(input)
    y, mo, d, h, mi, s, n, j = parse.iso_datetime(cs, 0)?
    parse.iso_end(cs, j)?
    ret ok(DateTime(date=Date.of(y, mo, d)?, time=Time.of_nanos(h, mi, s, n)?))

// `dt + d` is exact: every day has 24 hours, since a DateTime has no zone.
impl add[Duration] for DateTime:
    fn add(self, d: Duration) -> Self:
        ret datetime_from_local(add_exact(local_seconds(self), d.secs, "date and time"), self.time.nanosecond + d.nanos)

impl sub[Duration] for DateTime:
    fn sub(self, d: Duration) -> Self:
        ret self + -d

// `dt + p` adds `p` to the date, keeping the time of day.
impl add[Period] for DateTime:
    fn add(self, p: Period) -> Self:
        ret DateTime(date=self.date + p, time=self.time)

impl sub[Period] for DateTime:
    fn sub(self, p: Period) -> Self:
        ret self + -p

impl ord for DateTime:
    fn cmp(self, other: DateTime) -> ordering:
        c = self.date.cmp(other.date)
        if c != equal:
            ret c
        ret self.time.cmp(other.time)

// ISO 8601: "2026-11-06T19:13:31".
impl display for DateTime:
    fn display(self) -> str:
        ret "{self.date}T{self.time}"

// ---------------------------------------------------------------------------------------------
// OffsetDateTime

// A date and time at a fixed offset from UTC, which names one instant, as RFC 3339 writes:
// "2026-11-06T19:13:31-06:00".
pub struct OffsetDateTime:
    datetime: DateTime
    offset: Offset

impl OffsetDateTime:
    fn new(datetime: DateTime, offset: Offset) -> OffsetDateTime:
        ret OffsetDateTime(datetime=datetime, offset=offset)

    fn of(year: int, month: int, day: int, hour: int, minute: int, second: int, offset: Offset) -> result[OffsetDateTime, str]:
        dt = DateTime.of(year, month, day, hour, minute, second)?
        ret ok(OffsetDateTime(datetime=dt, offset=offset))

    // The date and time now, in UTC.
    fn now_utc() -> OffsetDateTime:
        ret Instant.now().to_utc()

    // The date and time at `offset` of the instant `i`.
    fn from_instant(i: Instant, offset: Offset) -> OffsetDateTime:
        ret OffsetDateTime(datetime=datetime_from_local(add_exact(i.secs, offset.seconds, "date and time"), i.nanos), offset=offset)

    fn date(self) -> Date:
        ret self.datetime.date

    fn time(self) -> Time:
        ret self.datetime.time

    fn to_instant(self) -> Instant:
        ret instant(local_seconds(self.datetime) - self.offset.seconds, self.datetime.time.nanosecond)

    // The same instant at another offset.
    fn to_offset(self, offset: Offset) -> OffsetDateTime:
        ret OffsetDateTime.from_instant(self.to_instant(), offset)

    fn to_utc(self) -> OffsetDateTime:
        ret self.to_offset(Offset.utc())

    // The same instant in `zone`.
    fn in_zone(self, zone: TimeZone) -> ZonedDateTime:
        ret zoned(self.to_instant(), zone)

    // The duration from this instant to `other`'s, negative if `other` is earlier.
    fn duration_until(self, other: OffsetDateTime) -> Duration:
        ret other.to_instant().duration_since(self.to_instant())

    // Writes the date, time, and offset as `pattern` says.
    fn format(self, pattern: str) -> str:
        ret format_or_stop(fmt.Fields(kind="OffsetDateTime", date=date_parts(self.datetime.date), time=time_parts(self.datetime.time), offset=some(self.offset.seconds), zone=none), pattern)

    // Reads a date, time, and offset written as `pattern` says. The pattern must read all
    // three, or the seconds since 1970 with `%s`, which are in UTC unless it reads an offset.
    fn parse(input: str, pattern: str) -> result[OffsetDateTime, str]:
        ret context(offset_datetime_parse(input, pattern), "cannot parse '{input}' with '{pattern}'")

    // Reads an RFC 3339 / ISO 8601 date and time with an offset, as
    // "2026-11-06T19:13:31-06:00" or "2026-11-07T01:13:31.5Z".
    fn parse_iso(input: str) -> result[OffsetDateTime, str]:
        ret context(offset_datetime_iso(input), "cannot parse '{input}' as an ISO 8601 date and time with an offset")

fn offset_datetime_parse(input: str, pattern: str) -> result[OffsetDateTime, str]:
    p = parse.strptime(input, pattern)?
    if p.offset.is_none() and p.unix.is_none():
        ret err("the pattern reads no offset")
    dt = datetime_parse(input, pattern)?
    ret ok(OffsetDateTime(datetime=dt, offset=Offset.of_seconds(p.offset.unwrap_or(0))?))

fn offset_datetime_iso(input: str) -> result[OffsetDateTime, str]:
    cs = text.chars(input)
    y, mo, d, h, mi, s, n, j = parse.iso_datetime(cs, 0)?
    off, j = parse.iso_offset(cs, j)?
    parse.iso_end(cs, j)?
    dt = DateTime(date=Date.of(y, mo, d)?, time=Time.of_nanos(h, mi, s, n)?)
    ret ok(OffsetDateTime(datetime=dt, offset=Offset.of_seconds(off)?))

// `odt + d` and `odt + p` keep the offset.
impl add[Duration] for OffsetDateTime:
    fn add(self, d: Duration) -> Self:
        ret OffsetDateTime(datetime=self.datetime + d, offset=self.offset)

impl sub[Duration] for OffsetDateTime:
    fn sub(self, d: Duration) -> Self:
        ret self + -d

impl add[Period] for OffsetDateTime:
    fn add(self, p: Period) -> Self:
        ret OffsetDateTime(datetime=self.datetime + p, offset=self.offset)

impl sub[Period] for OffsetDateTime:
    fn sub(self, p: Period) -> Self:
        ret self + -p

// Earlier instants first, and for one instant, the lower offset first, as java.time does.
impl ord for OffsetDateTime:
    fn cmp(self, other: OffsetDateTime) -> ordering:
        c = self.to_instant().cmp(other.to_instant())
        if c != equal:
            ret c
        ret self.datetime.cmp(other.datetime)

// RFC 3339: "2026-11-06T19:13:31-06:00", or "...Z" in UTC.
impl display for OffsetDateTime:
    fn display(self) -> str:
        ret "{self.datetime}{self.offset}"

// ---------------------------------------------------------------------------------------------
// Instant

// A point in time, `secs` seconds and `nanos` nanoseconds after 1970-01-01T00:00:00Z, with
// `nanos` from 0 to 999999999. It has no calendar or offset until it is given one, with
// `at_offset` or `to_utc`.
pub struct Instant:
    secs: int
    nanos: int

fn instant(secs: int, nanos: int) -> Instant:
    s = add_exact(secs, civil.floor_div(nanos, ns), "instant")
    assert s >= min_unix_seconds and s <= max_unix_seconds, "datetime: instant {s} seconds from 1970 is outside the supported years (-999999 to 999999)"
    ret Instant(secs=s, nanos=civil.floor_mod(nanos, ns))

impl Instant:
    // The instant now, from the system clock, to the microsecond, since `time.now` gives the
    // time as a float.
    fn now() -> Instant:
        t = time.now()
        s = t.floor()
        micros = int((t - float(s)) * 1_000_000.0 + 0.5).unwrap()
        ret instant(s, micros * 1000)

    fn from_unix(seconds: int) -> Instant:
        ret instant(seconds, 0)

    fn from_unix_millis(millis: int) -> Instant:
        ret instant(civil.floor_div(millis, 1000), civil.floor_mod(millis, 1000) * 1_000_000)

    fn from_unix_micros(micros: int) -> Instant:
        ret instant(civil.floor_div(micros, 1_000_000), civil.floor_mod(micros, 1_000_000) * 1000)

    fn from_unix_nanos(nanos: int) -> Instant:
        ret instant(civil.floor_div(nanos, ns), civil.floor_mod(nanos, ns))

    // The whole seconds since 1970-01-01T00:00:00Z, rounded down, so they are negative before.
    fn unix_seconds(self) -> int:
        ret self.secs

    // The milliseconds since 1970-01-01T00:00:00Z, rounded down.
    fn unix_millis(self) -> int:
        ret self.secs * 1000 + self.nanos / 1_000_000

    fn unix_micros(self) -> int:
        ret self.secs * 1_000_000 + self.nanos / 1000

    // The nanoseconds since 1970-01-01T00:00:00Z. It stops the program for instants outside
    // 1677 to 2262, which do not fit in an int.
    fn unix_nanos(self) -> int:
        ret add_exact(mul_exact(self.secs, ns, "unix nanoseconds"), self.nanos, "unix nanoseconds")

    // The duration from `earlier` to this instant, negative if `earlier` is later.
    fn duration_since(self, earlier: Instant) -> Duration:
        ret duration(self.secs - earlier.secs, self.nanos - earlier.nanos)

    // The duration from this instant to now.
    fn elapsed(self) -> Duration:
        ret Instant.now().duration_since(self)

    fn at_offset(self, offset: Offset) -> OffsetDateTime:
        ret OffsetDateTime.from_instant(self, offset)

    fn to_utc(self) -> OffsetDateTime:
        ret OffsetDateTime.from_instant(self, Offset.utc())

    fn in_zone(self, zone: TimeZone) -> ZonedDateTime:
        ret zoned(self, zone)

    // Writes the instant in UTC as `pattern` says.
    fn format(self, pattern: str) -> str:
        ret self.to_utc().format(pattern)

    // Reads an instant written as `pattern` says, which must read an offset or `%s`.
    fn parse(input: str, pattern: str) -> result[Instant, str]:
        odt = OffsetDateTime.parse(input, pattern)?
        ret ok(odt.to_instant())

    // Reads an RFC 3339 / ISO 8601 date and time with an offset, as "2026-11-07T01:13:31Z".
    fn parse_iso(input: str) -> result[Instant, str]:
        odt = OffsetDateTime.parse_iso(input)?
        ret ok(odt.to_instant())

impl add[Duration] for Instant:
    fn add(self, d: Duration) -> Self:
        ret instant(add_exact(self.secs, d.secs, "instant"), self.nanos + d.nanos)

impl sub[Duration] for Instant:
    fn sub(self, d: Duration) -> Self:
        ret self + -d

impl ord for Instant:
    fn cmp(self, other: Instant) -> ordering:
        ret chain(self.secs.cmp(other.secs), self.nanos, other.nanos)

// RFC 3339 in UTC: "2026-11-07T01:13:31Z".
impl display for Instant:
    fn display(self) -> str:
        ret str(self.to_utc())

// ---------------------------------------------------------------------------------------------
// TimeZone

// A time zone: a name and the rules that give its offset from UTC at every instant. A zone of
// the IANA database, such as America/Chicago, is at -06:00 in winter and -05:00 in summer.
// `TimeZone.get` reads one from the system's copy of the database, so load a zone once and
// keep it rather than loading it for every value.
pub struct TimeZone:
    name: str
    rules: tz.Rules

impl TimeZone:
    fn utc() -> TimeZone:
        ret TimeZone(name="UTC", rules=tz.fixed(0, "UTC"))

    // The zone always at `offset`, named as the offset is written, as "+05:30".
    fn fixed(offset: Offset) -> TimeZone:
        if offset.seconds == 0:
            ret TimeZone.utc()
        name = text.offset_text(offset.seconds, true)
        ret TimeZone(name=name, rules=tz.fixed(offset.seconds, name))

    // The zone named `name`: "UTC", a fixed offset such as "+05:30", "localtime" for the
    // system's zone, or a zone of the IANA database such as "America/Chicago", read from `TZDIR`
    // or the system's zoneinfo directory.
    fn get(name: str) -> result[TimeZone, str]:
        if name == "UTC" or name == "Z":
            ret ok(TimeZone.utc())
        // The system's zone, also named "localtime" when its real name is unknown.
        if name == "localtime":
            ret ok(TimeZone.local())
        if name.startswith("+") or name.startswith("-"):
            ret ok(TimeZone.fixed(Offset.parse_iso(name)?))
        ret ok(TimeZone(name=name, rules=tz.load(name)?))

    // The system's time zone: the one `TZ` names, or else the one `/etc/localtime` holds, or
    // else UTC. On Windows it is UTC unless `TZ` is set.
    fn local() -> TimeZone:
        name, rules = tz.local()
        ret TimeZone(name=name, rules=rules)

    // The zone a POSIX TZ string describes, as "CST6CDT,M3.2.0,M11.1.0", named by the string.
    fn posix(spec: str) -> result[TimeZone, str]:
        p = context(tz.read_posix(spec), "cannot parse '{spec}' as a POSIX TZ string")?
        ret ok(TimeZone(name=spec, rules=tz.from_posix(p)))

    // The zone in the TZif file `data` (RFC 8536), such as one in /usr/share/zoneinfo, named
    // `name`.
    fn from_tzif(name: str, data: bytes) -> result[TimeZone, str]:
        rules = context(tz.read_tzif(data), "cannot read time zone '{name}'")?
        ret ok(TimeZone(name=name, rules=rules))

    // The zone's offset from UTC at instant `i`.
    fn offset_at(self, i: Instant) -> Offset:
        ret Offset(seconds=tz.offset_at(self.rules, i.secs))

    // The abbreviation of the zone's time at instant `i`, as "CST" or "CDT".
    fn abbreviation_at(self, i: Instant) -> str:
        _o, _dst, abbr = tz.info_at(self.rules, i.secs)
        ret abbr

    // Whether the zone is on daylight saving time at instant `i`.
    fn is_dst_at(self, i: Instant) -> bool:
        _o, dst, _abbr = tz.info_at(self.rules, i.secs)
        ret dst

    // What the wall clock time `dt` means in this zone: one instant, two when the clocks go
    // back and show it twice, or none when they skip it.
    fn resolve(self, dt: DateTime) -> LocalTime:
        n, a, b = tz.local_offsets(self.rules, local_seconds(dt))
        match n:
            case 1:
                ret LocalTime.Unique(at=OffsetDateTime(datetime=dt, offset=Offset(seconds=a)))
            case 2:
                ret LocalTime.Ambiguous(earlier=OffsetDateTime(datetime=dt, offset=Offset(seconds=a)), later=OffsetDateTime(datetime=dt, offset=Offset(seconds=b)))
            case _:
                ret LocalTime.Gap(before=Offset(seconds=a), after=Offset(seconds=b))

// The zone's name, as "America/Chicago".
impl display for TimeZone:
    fn display(self) -> str:
        ret self.name

// What a wall clock time means in a time zone, from `TimeZone.resolve`.
pub enum LocalTime:
    // The usual case: one instant.
    Unique(at: OffsetDateTime)
    // The clocks show the time twice, as when they go back an hour in autumn: first at
    // `earlier`'s offset, then at `later`'s.
    Ambiguous(earlier: OffsetDateTime, later: OffsetDateTime)
    // The clocks skip the time, as when they go forward an hour in spring, from offset `before`
    // to offset `after`.
    Gap(before: Offset, after: Offset)

// How to turn a wall clock time that the clocks skip or show twice into one instant, as in
// JavaScript's Temporal.
pub enum Disambiguation:
    // A skipped time moves later by the length of the gap, so 02:30 on the night the clocks
    // skip from 02:00 to 03:00 is 03:30. A time shown twice is the earlier instant.
    Compatible
    // The earlier instant: for a skipped time, the gap's length earlier (01:30 above).
    Earlier
    // The later instant: for a skipped time, the gap's length later (03:30 above).
    Later
    // An error for a time that is skipped or shown twice.
    Reject

// ---------------------------------------------------------------------------------------------
// ZonedDateTime

// A date and time in a time zone, which names one instant, as
// "2026-11-06T19:13:31-06:00[America/Chicago]". `offset` is always the zone's offset at the
// instant, so build values with the functions here rather than by hand.
pub struct ZonedDateTime:
    datetime: DateTime
    offset: Offset
    zone: TimeZone

// Instant `i` in `zone`.
fn zoned(i: Instant, zone: TimeZone) -> ZonedDateTime:
    o = zone.offset_at(i)
    ret ZonedDateTime(datetime=OffsetDateTime.from_instant(i, o).datetime, offset=o, zone=zone)

// Wall clock time `dt` in `zone`, choosing as `how` says when the clocks skip or repeat it. For
// a repeated time, `prefer` is kept if it is one of its offsets.
fn zoned_local(dt: DateTime, zone: TimeZone, how: Disambiguation, prefer: option[Offset]) -> result[ZonedDateTime, str]:
    match zone.resolve(dt):
        case LocalTime.Unique(at):
            ret ok(ZonedDateTime(datetime=dt, offset=at.offset, zone=zone))
        case LocalTime.Ambiguous(earlier, later):
            if prefer == some(later.offset):
                ret ok(ZonedDateTime(datetime=dt, offset=later.offset, zone=zone))
            if prefer == some(earlier.offset):
                ret ok(ZonedDateTime(datetime=dt, offset=earlier.offset, zone=zone))
            match how:
                case Disambiguation.Later:
                    ret ok(ZonedDateTime(datetime=dt, offset=later.offset, zone=zone))
                case Disambiguation.Reject:
                    ret err("{dt} happens twice in {zone}, at {earlier.offset} and then at {later.offset}")
                case _:
                    ret ok(ZonedDateTime(datetime=dt, offset=earlier.offset, zone=zone))
        case LocalTime.Gap(before, after):
            match how:
                case Disambiguation.Earlier:
                    ret ok(zoned(dt.at_offset(after).to_instant(), zone))
                case Disambiguation.Reject:
                    ret err("{dt} does not exist in {zone}, whose clocks skip it going from {before} to {after}")
                case _:
                    ret ok(zoned(dt.at_offset(before).to_instant(), zone))

// Wall clock time `dt` in `zone`, at offset `offset` if one is given, which must be the zone's
// offset then.
fn zoned_at(dt: DateTime, offset: option[Offset], zone: TimeZone) -> result[ZonedDateTime, str]:
    match offset:
        case some(o):
            z = zoned(dt.at_offset(o).to_instant(), zone)
            if z.offset != o:
                ret err("{zone} is not at offset {o} at {dt}")
            ret ok(z)
        case none:
            ret ok(ZonedDateTime.new(dt, zone))

impl ZonedDateTime:
    // The date and time in `zone`, as `ZonedDateTime.new` resolves it.
    fn of(year: int, month: int, day: int, hour: int, minute: int, second: int, zone: TimeZone) -> result[ZonedDateTime, str]:
        dt = DateTime.of(year, month, day, hour, minute, second)?
        ret ok(ZonedDateTime.new(dt, zone))

    // Wall clock time `dt` in `zone`. A time the clocks skip moves later by the length of the
    // gap, and a time they show twice is the earlier instant (`Disambiguation.Compatible`).
    fn new(datetime: DateTime, zone: TimeZone) -> ZonedDateTime:
        ret zoned_local(datetime, zone, Disambiguation.Compatible, none).unwrap()

    // Wall clock time `dt` in `zone`, choosing as `how` says when the clocks skip it or show it
    // twice. Only `Disambiguation.Reject` returns an error.
    fn from_local(datetime: DateTime, zone: TimeZone, how: Disambiguation) -> result[ZonedDateTime, str]:
        ret zoned_local(datetime, zone, how, none)

    fn from_instant(i: Instant, zone: TimeZone) -> ZonedDateTime:
        ret zoned(i, zone)

    // The date and time now in `zone`.
    fn now(zone: TimeZone) -> ZonedDateTime:
        ret zoned(Instant.now(), zone)

    // The date and time now in the system's time zone.
    fn now_local() -> ZonedDateTime:
        ret zoned(Instant.now(), TimeZone.local())

    fn date(self) -> Date:
        ret self.datetime.date

    fn time(self) -> Time:
        ret self.datetime.time

    fn to_instant(self) -> Instant:
        ret instant(local_seconds(self.datetime) - self.offset.seconds, self.datetime.time.nanosecond)

    fn to_offset_datetime(self) -> OffsetDateTime:
        ret OffsetDateTime(datetime=self.datetime, offset=self.offset)

    // The same instant in another zone.
    fn in_zone(self, zone: TimeZone) -> ZonedDateTime:
        ret zoned(self.to_instant(), zone)

    // The zone's abbreviation at this instant, as "CST".
    fn abbreviation(self) -> str:
        ret self.zone.abbreviation_at(self.to_instant())

    fn is_dst(self) -> bool:
        ret self.zone.is_dst_at(self.to_instant())

    // The same wall clock time `n` days later, which is not always `n` times 24 hours.
    fn add_days(self, n: int) -> ZonedDateTime:
        ret self + Period.of_days(n)

    // The duration from this instant to `other`'s, negative if `other` is earlier.
    fn duration_until(self, other: ZonedDateTime) -> Duration:
        ret other.to_instant().duration_since(self.to_instant())

    // Writes the date, time, and zone as `pattern` says. `%Z` writes the zone's abbreviation.
    fn format(self, pattern: str) -> str:
        ret format_or_stop(fmt.Fields(kind="ZonedDateTime", date=date_parts(self.datetime.date), time=time_parts(self.datetime.time), offset=some(self.offset.seconds), zone=some(self.abbreviation())), pattern)

    // Reads a date and time in `zone` written as `pattern` says. An offset the text gives must
    // be the zone's offset then, and picks between the two instants of a time shown twice.
    fn parse(input: str, pattern: str, zone: TimeZone) -> result[ZonedDateTime, str]:
        ret context(zoned_parse(input, pattern, zone), "cannot parse '{input}' with '{pattern}'")

    // Reads an RFC 9557 date and time with its zone's name in brackets, as
    // "2026-11-06T19:13:31-06:00[America/Chicago]". The offset may be left out, as in
    // "2026-11-06T19:13:31[America/Chicago]", and if it is there it must be the zone's offset.
    fn parse_iso(input: str) -> result[ZonedDateTime, str]:
        ret context(zoned_iso(input), "cannot parse '{input}' as an ISO 8601 date and time in a time zone")

fn zoned_parse(input: str, pattern: str, zone: TimeZone) -> result[ZonedDateTime, str]:
    p = parse.strptime(input, pattern)?
    dt = datetime_parse(input, pattern)?
    if p.offset.is_some():
        ret zoned_at(dt, some(Offset.of_seconds(p.offset.unwrap())?), zone)
    if p.unix.is_some():
        ret ok(zoned(dt.assume_utc(), zone))
    ret zoned_at(dt, none, zone)

fn zoned_iso(input: str) -> result[ZonedDateTime, str]:
    cs = text.chars(input)
    y, mo, d, h, mi, s, n, j = parse.iso_datetime(cs, 0)?
    dt = DateTime(date=Date.of(y, mo, d)?, time=Time.of_nanos(h, mi, s, n)?)
    offset = none
    if j < cs.len() and cs[j] != "[":
        o, k = parse.iso_offset(cs, j)?
        offset = some(Offset.of_seconds(o)?)
        j = k
    if j >= cs.len() or cs[j] != "[":
        ret err("expected '[' and a time zone name at position {j}")
    k = j + 1
    while k < cs.len() and cs[k] != "]":
        k += 1
    if k >= cs.len():
        ret err("expected ']' after the time zone name at position {j}")
    parse.iso_end(cs, k + 1)?
    ret zoned_at(dt, offset, TimeZone.get("".join(cs[j + 1:k]))?)

// `zdt + d` is `d` later in exact time, so a day of 24 hours over a change of the clocks ends at
// another wall clock time.
impl add[Duration] for ZonedDateTime:
    fn add(self, d: Duration) -> Self:
        ret zoned(self.to_instant() + d, self.zone)

impl sub[Duration] for ZonedDateTime:
    fn sub(self, d: Duration) -> Self:
        ret self + -d

// `zdt + p` adds `p` to the wall clock date, keeping the time of day, so a day later is the same
// time of day. A time the clocks skip moves later by the length of the gap, and a time they show
// twice keeps the offset if it can, as java.time does.
impl add[Period] for ZonedDateTime:
    fn add(self, p: Period) -> Self:
        ret zoned_local(self.datetime + p, self.zone, Disambiguation.Compatible, some(self.offset)).unwrap()

impl sub[Period] for ZonedDateTime:
    fn sub(self, p: Period) -> Self:
        ret self + -p

// Earlier instants first, then by wall clock time, then by the zone's name.
impl ord for ZonedDateTime:
    fn cmp(self, other: ZonedDateTime) -> ordering:
        c = self.to_instant().cmp(other.to_instant())
        if c != equal:
            ret c
        c = self.datetime.cmp(other.datetime)
        if c != equal:
            ret c
        ret self.zone.name.cmp(other.zone.name)

// RFC 9557: "2026-11-06T19:13:31-06:00[America/Chicago]".
impl display for ZonedDateTime:
    fn display(self) -> str:
        ret "{self.datetime}{self.offset}[{self.zone.name}]"

// ---------------------------------------------------------------------------------------------
// Tests

fn check(d: Date, epoch_days: int, weekday: int, day_of_year: int, iso_year: int, iso_week: int):
    assert d.to_epoch_days() == epoch_days, "{d}: epoch days {d.to_epoch_days()} != {epoch_days}"
    assert Date.from_epoch_days(epoch_days) == d, "{d}: from_epoch_days({epoch_days})"
    assert weekday_number(d.weekday()) == weekday, "{d}: weekday"
    assert d.day_of_year() == day_of_year, "{d}: day of year"
    assert d.iso_week() == (iso_year, iso_week), "{d}: ISO week"
    assert Date.parse_iso(str(d)) == ok(d), "{d}: ISO round trip"

