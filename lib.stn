test "building dates":
    assert Date.of(2026, 11, 6).unwrap().year == 2026
    assert Date.of(2024, 2, 29).is_ok()
    assert Date.of(2023, 2, 29) == err("day 29 is out of range for 2023-02 (1 to 28)")
    assert Date.of(2026, 13, 1) == err("month 13 is out of range (1 to 12)")
    assert Date.of(1000000, 1, 1) == err("year 1000000 is out of range (-999999 to 999999)")
    assert Date.from_ordinal(2026, 310) == Date.of(2026, 11, 6)
    assert Date.from_ordinal(2026, 366).is_err()
    assert Date.from_iso_week(2020, 53, Weekday.Sunday) == Date.of(2021, 1, 3)
    assert Date.from_iso_week(2021, 53, Weekday.Monday).is_err()
    assert Date.from_epoch_days(0) == Date.of(1970, 1, 1).unwrap()

test "date facts":
    d = Date.of(2026, 11, 6).unwrap()
    assert d.weekday() == Weekday.Friday
    assert weekday_name(d.weekday()) == "Friday"
    assert d.days_in_month() == 30
    assert d.days_in_year() == 365
    assert not d.is_leap_year()
    assert d.first_of_month() == Date.of(2026, 11, 1).unwrap()
    assert d.last_of_month() == Date.of(2026, 11, 30).unwrap()
    assert is_leap_year(2024) and not is_leap_year(2100)
    assert days_in_month(2024, 2) == 29
    assert days_in_year(2000) == 366
    assert weekday_from_number(7) == ok(Weekday.Sunday)
    assert weekday_from_number(0).is_err()

test "date arithmetic":
    d = Date.of(2026, 1, 31).unwrap()
    assert d.add_days(1) == Date.of(2026, 2, 1).unwrap()
    assert d.add_days(-31) == Date.of(2025, 12, 31).unwrap()
    assert d.add_weeks(2) == Date.of(2026, 2, 14).unwrap()
    assert d.add_months(1) == Date.of(2026, 2, 28).unwrap()
    assert d.add_months(-2) == Date.of(2025, 11, 30).unwrap()
    assert d.add_months(13) == Date.of(2027, 2, 28).unwrap()
    assert Date.of(2024, 2, 29).unwrap().add_years(1) == Date.of(2025, 2, 28).unwrap()
    assert Date.of(2024, 2, 29).unwrap().add_years(4) == Date.of(2028, 2, 29).unwrap()
    assert d.add_period(Period.of(1, 1, 1)) == Date.of(2027, 3, 1).unwrap()
    assert d.days_until(Date.of(2026, 3, 1).unwrap()) == 29
    assert Date.of(2026, 3, 1).unwrap().days_until(d) == -29
    assert Date.of(1, 1, 1).unwrap().add_days(-1) == Date.of(0, 12, 31).unwrap()

test "date ordering and display":
    a = Date.of(2026, 11, 6).unwrap()
    b = Date.of(2026, 12, 1).unwrap()
    assert a < b and b > a and a <= a and a != b
    xs = [b, a]
    xs.sort()
    assert xs == [a, b]
    assert str(a) == "2026-11-06"
    assert str(Date.of(-44, 3, 15).unwrap()) == "-0044-03-15"
    assert str(Date.of(12026, 1, 2).unwrap()) == "+12026-01-02"

test "date formatting":
    d = Date.of(2026, 11, 6).unwrap()
    assert d.format("%d %B %Y") == "06 November 2026"
    assert d.format("%A, %-d %b %Y") == "Friday, 6 Nov 2026"
    assert d.format("%G-W%V-%u") == "2026-W45-5"
    assert d.format("%j") == "310"

test "date parsing":
    d = Date.of(2026, 11, 6).unwrap()
    assert Date.parse("06/11/2026", "%d/%m/%Y") == ok(d)
    assert Date.parse("November 6, 2026", "%B %d, %Y") == ok(d)
    assert Date.parse("2026-W45-5", "%G-W%V-%u") == ok(d)
    assert Date.parse("2026-02-30", "%F") == err("cannot parse '2026-02-30' with '%F': day 30 is out of range for 2026-02 (1 to 28)")
    assert Date.parse("19:00", "%H:%M") == err("cannot parse '19:00' with '%H:%M': the pattern reads no date")
    assert Date.parse_iso("2026-11-06") == ok(d)
    assert Date.parse_iso("+012026-11-06") == Date.of(12026, 11, 6)
    assert Date.parse_iso("2026-11-6") == err("cannot parse '2026-11-6' as an ISO 8601 date: expected 2 digits at position 8")
    assert Date.parse_iso("2026-11-06 ") == err("cannot parse '2026-11-06 ' as an ISO 8601 date: unexpected ' ' at position 10")

test "times":
    t = Time.of_nanos(19, 13, 31, 500000000).unwrap()
    assert str(t) == "19:13:31.500"
    assert str(Time.of(7, 5, 0).unwrap()) == "07:05:00"
    assert str(Time.of_nanos(0, 0, 0, 1).unwrap()) == "00:00:00.000000001"
    assert Time.of(24, 0, 0) == err("hour 24 is out of range (0 to 23)")
    assert Time.of(23, 59, 60) == err("second 60 is out of range (0 to 59)")
    assert t.seconds_of_day() == 69211
    assert Time.from_seconds_of_day(69211) == Time.of(19, 13, 31)
    assert Time.from_nanos_of_day(t.nanos_of_day()) == ok(t)
    assert Time.from_seconds_of_day(86400).is_err()
    assert Time.midnight() < Time.noon()

test "time arithmetic goes around midnight":
    t = Time.of(23, 30, 0).unwrap()
    assert t.add(Duration.of_minutes(45)) == Time.of(0, 15, 0).unwrap()
    assert t.add(Duration.of_days(3)) == t
    assert Time.of(0, 15, 0).unwrap().sub(Duration.of_minutes(30)) == Time.of(23, 45, 0).unwrap()
    assert t.add(Duration.of_millis(-1)) == Time.of_nanos(23, 29, 59, 999000000).unwrap()
    assert Time.noon().duration_until(t) == Duration.of_minutes(690)
    assert t.duration_until(Time.noon()) == Duration.of_minutes(-690)

test "time formatting and parsing":
    t = Time.of_nanos(19, 3, 31, 250000000).unwrap()
    assert t.format("%I:%M %p") == "07:03 PM"
    assert t.format("%H:%M:%S.%3f") == "19:03:31.250"
    assert Time.parse("7:03 pm", "%I:%M %p") == Time.of(19, 3, 0)
    assert Time.parse("19:03:31.25", "%T.%f") == ok(t)
    assert Time.parse_iso("19:03:31.25") == ok(t)
    assert Time.parse_iso("19:03") == Time.of(19, 3, 0)
    assert Time.parse_iso("24:00:00").is_err()
    assert Time.parse_iso("23:59:60").is_err()

test "durations":
    assert Duration.of_seconds(90).whole_minutes() == 1
    assert Duration.of_seconds(-90).whole_minutes() == -1
    assert Duration.of_millis(-1500) == Duration(secs=-2, nanos=500000000)
    assert Duration.of_millis(-1500).whole_seconds() == -1
    assert Duration.of_millis(-1500).whole_millis() == -1500
    assert Duration.of_micros(-1).whole_millis() == 0
    assert Duration.of_nanos(-1).whole_nanos() == -1
    assert Duration.of_hours(2).add(Duration.of_minutes(30)) == Duration.of_minutes(150)
    assert Duration.of_seconds(1).sub(Duration.of_millis(1500)) == Duration.of_millis(-500)
    assert Duration.of_millis(1500).neg().neg() == Duration.of_millis(1500)
    assert Duration.of_millis(-1500).abs() == Duration.of_millis(1500)
    assert Duration.of_millis(-1500).is_negative()
    assert Duration.zero().is_zero()
    assert Duration.of_seconds(1) > Duration.of_millis(999)
    assert Duration.of_millis(1500).as_seconds_float() == 1.5
    assert Duration.of_seconds_float(-1.5) == Duration.of_millis(-1500)
    assert Duration.of_days(1).whole_hours() == 24

test "duration multiplication and division are exact":
    d = Duration.of_millis(1500)
    assert d.mul(3) == Duration.of_millis(4500)
    assert d.mul(-1) == Duration.of_millis(-1500)
    assert Duration.of_nanos(5).mul(10000000000) == Duration.of_seconds(50)
    assert d.mul(0).is_zero()
    assert d.div(2) == Duration.of_millis(750)
    assert d.div(-2) == Duration.of_millis(-750)
    assert Duration.of_nanos(-7).div(2) == Duration.of_nanos(-3)
    assert Duration.of_seconds(1).div(3) == Duration.of_nanos(333333333)
    assert Duration.of_days(365000000).div(7) == Duration(secs=4505142857142, nanos=857142857)
    big = Duration(secs=4611686018427387903, nanos=999999999)
    assert big.div(100000000000) == Duration(secs=46116860, nanos=184273879)
    assert big.div(-9223372036854775807 - 1) == Duration.of_nanos(-499999999)
    assert big.div(1) == big

test "duration display and parsing":
    assert str(Duration.of_minutes(90)) == "PT1H30M"
    assert str(Duration.of_millis(500)) == "PT0.5S"
    assert str(Duration.of_hours(-36)) == "-PT36H"
    assert str(Duration.zero()) == "PT0S"
    assert str(Duration.of_seconds(3601)) == "PT1H1S"
    assert str(Duration.of_millis(-1500)) == "-PT1.5S"
    assert Duration.parse_iso("PT1H30M") == ok(Duration.of_minutes(90))
    assert Duration.parse_iso("P1DT0.5S") == ok(Duration.of_millis(86400500))
    assert Duration.parse_iso("-PT1.5S") == ok(Duration.of_millis(-1500))
    assert Duration.parse_iso("P1M") == err("cannot parse 'P1M' as an ISO 8601 duration: 'M' at position 2 is a calendar unit; use a Period for it")

test "periods":
    p = Period.of(1, 2, 3)
    assert str(p) == "P1Y2M3D"
    assert str(Period.zero()) == "P0D"
    assert str(Period.of_weeks(2)) == "P14D"
    assert str(Period.of(-1, 2, 0)) == "P-1Y2M"
    assert p.add(Period.of_months(11)) == Period.of(1, 13, 3)
    assert p.neg() == Period.of(-1, -2, -3)
    assert Period.parse_iso("P1Y2M3D") == ok(p)
    assert Period.parse_iso("P2W") == ok(Period.of_days(14))
    assert Period.parse_iso("PT1H").is_err()

test "offsets":
    assert str(Offset.utc()) == "Z"
    assert str(Offset.of_hm(5, 30).unwrap()) == "+05:30"
    assert str(Offset.of_hm(-3, 30).unwrap()) == "-03:30"
    assert str(Offset.of_hours(-6).unwrap()) == "-06:00"
    assert str(Offset.of_seconds(-1800).unwrap()) == "-00:30"
    assert Offset.of_hours(19).is_err()
    assert Offset.of_seconds(64801).is_err()
    assert Offset.of_hm(5, 60).is_err()
    assert Offset.parse_iso("+05:30") == Offset.of_hm(5, 30)
    assert Offset.parse_iso("Z") == ok(Offset.utc())
    assert Offset.parse_iso("+19:00").is_err()
    assert Offset.of_hours(-6).unwrap() < Offset.utc()

test "date and time":
    dt = DateTime.of(2026, 11, 6, 19, 13, 31).unwrap()
    assert str(dt) == "2026-11-06T19:13:31"
    assert dt.date == Date.of(2026, 11, 6).unwrap()
    assert dt.time == Time.of(19, 13, 31).unwrap()
    assert Date.of(2026, 11, 6).unwrap().at(Time.of(19, 13, 31).unwrap()) == dt
    assert dt.add(Duration.of_hours(5)) == DateTime.of(2026, 11, 7, 0, 13, 31).unwrap()
    assert dt.sub(Duration.of_days(400)) == DateTime.of(2025, 10, 2, 19, 13, 31).unwrap()
    assert dt.add(Duration.of_millis(-1)).time.nanosecond == 999000000
    assert dt.add_days(25) == DateTime.of(2026, 12, 1, 19, 13, 31).unwrap()
    assert dt.add_period(Period.of_months(3)) == DateTime.of(2027, 2, 6, 19, 13, 31).unwrap()
    other = DateTime.of(2026, 11, 7, 0, 0, 0).unwrap()
    assert dt.duration_until(other) == Duration.of_seconds(17189)
    assert other.duration_until(dt) == Duration.of_seconds(-17189)
    assert dt < other
    assert DateTime.of(2026, 2, 29, 0, 0, 0).is_err()
    assert DateTime.of(2026, 2, 28, 24, 0, 0).is_err()

test "date and time formatting and parsing":
    dt = DateTime.of(2026, 11, 6, 19, 13, 31).unwrap()
    assert dt.format("%Y-%m-%d %H:%M:%S") == "2026-11-06 19:13:31"
    assert dt.format("%c") == "Fri Nov  6 19:13:31 2026"
    assert DateTime.parse("2026-11-06 19:13:31", "%Y-%m-%d %H:%M:%S") == ok(dt)
    assert DateTime.parse("06.11.2026 7:13:31 PM", "%d.%m.%Y %I:%M:%S %p") == ok(dt)
    assert DateTime.parse("2026-11-06", "%F") == err("cannot parse '2026-11-06' with '%F': the pattern reads no time of day")
    assert DateTime.parse_iso("2026-11-06T19:13:31") == ok(dt)
    assert DateTime.parse_iso("2026-11-06 19:13:31") == ok(dt)
    assert DateTime.parse_iso("2026-11-06T19:13:31.000000001") == ok(dt.add(Duration.of_nanos(1)))
    assert DateTime.parse_iso("2026-11-06T19:13:31Z").is_err()

test "instants":
    i = Instant.from_unix(1791512687)
    assert str(i) == "2026-10-09T02:24:47Z"
    assert i.unix_seconds() == 1791512687
    assert i.unix_millis() == 1791512687000
    assert Instant.from_unix_millis(-1) == Instant(secs=-1, nanos=999000000)
    assert Instant.from_unix_millis(-1).unix_millis() == -1
    assert Instant.from_unix_nanos(1791512687123456789).unix_nanos() == 1791512687123456789
    assert Instant.from_unix_micros(-1500000).unix_micros() == -1500000
    assert Instant.from_unix(0).to_utc() == OffsetDateTime.of(1970, 1, 1, 0, 0, 0, Offset.utc()).unwrap()
    assert Instant.from_unix(-1).to_utc().datetime == DateTime.of(1969, 12, 31, 23, 59, 59).unwrap()
    assert i.add(Duration.of_hours(1)).duration_since(i) == Duration.of_hours(1)
    assert i.sub(Duration.of_millis(1)) < i
    assert i.format("%s") == "1791512687"
    assert Instant.parse_iso("2026-10-09T02:24:47Z") == ok(i)
    assert Instant.parse_iso("2026-10-08T20:24:47-06:00") == ok(i)
    assert Instant.parse("1791512687", "%s") == ok(i)
    assert DateTime.of(2026, 10, 9, 2, 24, 47).unwrap().assume_utc() == i

test "the clock":
    a = Instant.now()
    b = Instant.now()
    assert a <= b
    assert a > Instant.from_unix(1700000000)
    assert not a.elapsed().is_negative()
    assert Date.today_utc() >= Date.of(2026, 1, 1).unwrap()
    assert DateTime.now_utc().date.year >= 2026
    assert OffsetDateTime.now_utc().offset == Offset.utc()

test "dates and times at an offset":
    cst = Offset.of_hours(-6).unwrap()
    odt = OffsetDateTime.of(2026, 11, 6, 19, 13, 31, cst).unwrap()
    assert str(odt) == "2026-11-06T19:13:31-06:00"
    assert str(odt.to_utc()) == "2026-11-07T01:13:31Z"
    assert odt.to_instant() == odt.to_utc().to_instant()
    assert odt.date() == Date.of(2026, 11, 6).unwrap()
    assert odt.time() == Time.of(19, 13, 31).unwrap()
    ist = Offset.of_hm(5, 30).unwrap()
    assert str(odt.to_offset(ist)) == "2026-11-07T06:43:31+05:30"
    assert odt.to_offset(ist) > odt
    assert odt.to_offset(ist).cmp(odt) == greater
    assert odt.to_utc().cmp(odt) == greater
    assert odt.duration_until(odt.to_offset(ist)) == Duration.zero()
    assert odt.add(Duration.of_hours(6)).datetime == DateTime.of(2026, 11, 7, 1, 13, 31).unwrap()
    assert odt.add_period(Period.of_days(1)).offset == cst
    assert odt.format("%Y-%m-%dT%H:%M:%S%:z") == "2026-11-06T19:13:31-06:00"
    assert odt.format("%a, %d %b %Y %T %z") == "Fri, 06 Nov 2026 19:13:31 -0600"

test "parsing dates and times at an offset":
    odt = OffsetDateTime.of(2026, 11, 6, 19, 13, 31, Offset.of_hours(-6).unwrap()).unwrap()
    assert OffsetDateTime.parse_iso("2026-11-06T19:13:31-06:00") == ok(odt)
    assert OffsetDateTime.parse_iso("2026-11-06t19:13:31-0600") == ok(odt)
    assert OffsetDateTime.parse_iso("2026-11-07T01:13:31.5Z").unwrap().datetime.time.nanosecond == 500000000
    assert OffsetDateTime.parse_iso("2026-11-06T19:13:31").is_err()
    assert OffsetDateTime.parse("Fri, 06 Nov 2026 19:13:31 -0600", "%a, %d %b %Y %T %z") == ok(odt)
    assert OffsetDateTime.parse("2026-11-06 19:13:31", "%F %T") == err("cannot parse '2026-11-06 19:13:31' with '%F %T': the pattern reads no offset")
    assert OffsetDateTime.parse("1791512687", "%s").unwrap().to_instant() == Instant.from_unix(1791512687)
    assert OffsetDateTime.parse("1791512687 +01:00", "%s %:z").unwrap().datetime == DateTime.of(2026, 10, 9, 3, 24, 47).unwrap()

test "the far ends of the supported years":
    lo = Date.of(-999999, 1, 1).unwrap()
    hi = Date.of(999999, 12, 31).unwrap()
    assert Date.from_epoch_days(lo.to_epoch_days()) == lo
    assert Date.from_epoch_days(hi.to_epoch_days()) == hi
    assert str(hi) == "+999999-12-31"
    assert str(lo) == "-999999-01-01"
    end = hi.at(Time.of_nanos(23, 59, 59, 999999999).unwrap())
    assert Instant.from_unix(31494784780799).to_utc().datetime == end.sub(Duration.of_nanos(999999999))
    assert lo.at(Time.midnight()).assume_utc() == Instant.from_unix(-31619087596800)
    assert lo.days_until(hi) == 730484633
