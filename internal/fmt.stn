// strftime-style formatting of the parts of a date, a time, and an offset. Internal to the
// datetime package: `lib.stn` builds a `Fields` from a value and calls `strftime`.

use internal.civil
use internal.text

// The parts of a value to format: a date as (year, month, day), a time as (hour, minute, second,
// nanosecond), an offset in seconds, and a zone's abbreviation, each `none` when the value has no
// such part. `kind` names the value's type for error messages, as "Date".
pub struct Fields:
    kind: str
    date: option[tuple[int, int, int]]
    time: option[tuple[int, int, int, int]]
    offset: option[int]
    zone: option[str]

// Writes `f` as `pattern` says, replacing each `%` specifier with a part of `f`, or returns an
// error for an unknown specifier or one `f` has no part for.
pub fn strftime(f: Fields, pattern: str) -> result[str, str]:
    cs = text.chars(pattern)
    out = ""
    i = 0
    while i < cs.len():
        c = cs[i]
        i += 1
        if c != "%":
            out += c
            cont
        if i >= cs.len():
            ret err("format pattern '{pattern}' ends with a lone '%'")
        no_pad = false
        colon = false
        digits = 9
        if cs[i] == "-" and i + 1 < cs.len():
            no_pad = true
            i += 1
        if cs[i] == ":" and i + 1 < cs.len() and cs[i + 1] == "z":
            colon = true
            i += 1
        if (cs[i] == "3" or cs[i] == "6" or cs[i] == "9") and i + 1 < cs.len() and cs[i + 1] == "f":
            digits = text.digit_value(cs[i])
            i += 1
        spec = cs[i]
        i += 1
        out += spec_text(f, spec, no_pad, colon, digits)?
    ret ok(out)

fn missing(f: Fields, spec: str, part: str) -> str:
    ret "'%{spec}' needs {part}, which a {f.kind} does not have"

fn date_of(f: Fields, spec: str) -> result[tuple[int, int, int], str]:
    match f.date:
        case some(ymd):
            ret ok(ymd)
        case none:
            ret err(missing(f, spec, "a date"))

fn time_of(f: Fields, spec: str) -> result[tuple[int, int, int, int], str]:
    match f.time:
        case some(hmsn):
            ret ok(hmsn)
        case none:
            ret err(missing(f, spec, "a time"))

fn offset_of(f: Fields, spec: str) -> result[int, str]:
    match f.offset:
        case some(o):
            ret ok(o)
        case none:
            ret err(missing(f, spec, "an offset"))

fn num(n: int, width: int, no_pad: bool) -> str:
    if no_pad:
        ret str(n)
    ret text.pad(n, width)

fn spec_text(f: Fields, spec: str, no_pad: bool, colon: bool, digits: int) -> result[str, str]:
    match spec:
        case "%":
            ret ok("%")
        case "n":
            ret ok("\n")
        case "t":
            ret ok("\t")
        // Specifiers spelled as other patterns.
        case "F":
            ret strftime(f, "%Y-%m-%d")
        case "D" | "x":
            ret strftime(f, "%m/%d/%y")
        case "T" | "X":
            ret strftime(f, "%H:%M:%S")
        case "R":
            ret strftime(f, "%H:%M")
        case "c":
            ret strftime(f, "%a %b %e %H:%M:%S %Y")
        case "Y" | "C" | "y" | "G" | "g" | "m" | "d" | "e" | "j" | "a" | "A" | "b" | "B" | "h" | "u" | "w" | "V" | "U" | "W":
            y, m, d = date_of(f, spec)?
            ret ok(date_spec(y, m, d, spec, no_pad))
        case "H" | "I" | "M" | "S" | "p" | "P" | "f":
            h, mi, s, n = time_of(f, spec)?
            ret ok(time_spec(h, mi, s, n, spec, no_pad, digits))
        case "z":
            ret ok(text.offset_text(offset_of(f, spec)?, colon))
        case "Z":
            o = offset_of(f, spec)?
            match f.zone:
                case some(abbr):
                    ret ok(abbr)
                case none:
                    if o == 0:
                        ret ok("UTC")
                    ret ok(text.offset_text(o, true))
        case "s":
            y, m, d = date_of(f, spec)?
            h, mi, s, _n = time_of(f, spec)?
            days = civil.days_from_civil(y, m, d)
            ret ok(str(days * 86400 + h * 3600 + mi * 60 + s - f.offset.unwrap_or(0)))
        case _:
            ret err("unknown format specifier '%{spec}'")

fn date_spec(y: int, m: int, d: int, spec: str, no_pad: bool) -> str:
    weekday = civil.weekday_from_days(civil.days_from_civil(y, m, d))
    match spec:
        case "Y":
            if no_pad:
                ret str(y)
            ret text.year_text(y)
        case "C":
            ret num(civil.floor_div(y, 100), 2, no_pad)
        case "y":
            ret num(civil.floor_mod(y, 100), 2, no_pad)
        case "m":
            ret num(m, 2, no_pad)
        case "d":
            ret num(d, 2, no_pad)
        case "e":
            if no_pad:
                ret str(d)
            ret "{d:>2}"
        case "j":
            ret num(civil.day_of_year(y, m, d), 3, no_pad)
        case "b" | "h":
            ret text.month_abbr(m)
        case "B":
            ret text.month_name(m)
        case "a":
            ret text.weekday_abbr(weekday)
        case "A":
            ret text.weekday_name(weekday)
        case "u":
            ret str(weekday)
        case "w":
            ret str(weekday % 7)
        case "U":
            // Weeks starting on Sunday, the first of which starts on the year's first Sunday,
            // with the days before it in week 0.
            ret num((civil.day_of_year(y, m, d) - 1 + 7 - weekday % 7) / 7, 2, no_pad)
        case "W":
            // The same, for weeks starting on Monday.
            ret num((civil.day_of_year(y, m, d) - 1 + 7 - (weekday - 1)) / 7, 2, no_pad)
        case _:
            iso_year, week = civil.iso_week(y, m, d)
            match spec:
                case "G":
                    if no_pad:
                        ret str(iso_year)
                    ret text.year_text(iso_year)
                case "g":
                    ret num(civil.floor_mod(iso_year, 100), 2, no_pad)
                case _:
                    ret num(week, 2, no_pad)

fn time_spec(h: int, mi: int, s: int, n: int, spec: str, no_pad: bool, digits: int) -> str:
    match spec:
        case "H":
            ret num(h, 2, no_pad)
        case "I":
            h12 = h % 12
            if h12 == 0:
                h12 = 12
            ret num(h12, 2, no_pad)
        case "M":
            ret num(mi, 2, no_pad)
        case "S":
            ret num(s, 2, no_pad)
        case "p":
            if h >= 12:
                ret "PM"
            ret "AM"
        case "P":
            if h >= 12:
                ret "pm"
            ret "am"
        case _:
            ret "{n:09}"[:digits]

fn sample() -> Fields:
    ret Fields(kind="OffsetDateTime", date=some((2026, 11, 6)), time=some((19, 3, 31, 123456789)), offset=some(-21600), zone=none)

test "dates":
    f = sample()
    assert strftime(f, "%Y-%m-%d") == ok("2026-11-06")
    assert strftime(f, "%F") == ok("2026-11-06")
    assert strftime(f, "%C %y %j") == ok("20 26 310")
    assert strftime(f, "%a %A %b %B %h") == ok("Fri Friday Nov November Nov")
    assert strftime(f, "%u %w %V %G %g") == ok("5 5 45 2026 26")
    assert strftime(f, "%U %W") == ok("44 44")
    assert strftime(f, "%D") == ok("11/06/26")

test "padding":
    f = sample()
    f.date = some((2026, 3, 7))
    assert strftime(f, "%e|%-d|%-m|%d") == ok(" 7|7|3|07")
    f.date = some((33, 3, 7))
    assert strftime(f, "%Y %-Y") == ok("0033 33")
    f.date = some((-44, 3, 7))
    assert strftime(f, "%Y %C %y") == ok("-0044 -01 56")

test "times":
    f = sample()
    assert strftime(f, "%H:%M:%S") == ok("19:03:31")
    assert strftime(f, "%T %R") == ok("19:03:31 19:03")
    assert strftime(f, "%I %p %P %-I") == ok("07 PM pm 7")
    assert strftime(f, "%f %3f %6f %9f") == ok("123456789 123 123456 123456789")
    f.time = some((0, 0, 0, 0))
    assert strftime(f, "%I %p") == ok("12 AM")
    f.time = some((12, 0, 0, 0))
    assert strftime(f, "%I %p") == ok("12 PM")

test "offsets, zones, and unix time":
    f = sample()
    assert strftime(f, "%z %:z %Z") == ok("-0600 -06:00 -06:00")
    f.zone = some("CST")
    assert strftime(f, "%z %Z") == ok("-0600 CST")
    f.zone = none
    f.offset = some(0)
    assert strftime(f, "%z %Z") == ok("+0000 UTC")
    f.date = some((1970, 1, 1))
    f.time = some((0, 0, 1, 0))
    f.offset = some(3600)
    assert strftime(f, "%s") == ok("-3599")
    f.offset = none
    f.kind = "DateTime"
    assert strftime(f, "%s") == ok("1")

test "literals and escapes":
    f = sample()
    assert strftime(f, "100%% on %d, ñ") == ok("100% on 06, ñ")
    assert strftime(f, "a%nb%tc") == ok("a\nb\tc")
    assert strftime(f, "") == ok("")
    assert strftime(f, "%c") == ok("Fri Nov  6 19:03:31 2026")

test "errors":
    f = Fields(kind="Date", date=some((2026, 11, 6)), time=none, offset=none, zone=none)
    assert strftime(f, "%H") == err("'%H' needs a time, which a Date does not have")
    assert strftime(f, "%Q") == err("unknown format specifier '%Q'")
    assert strftime(f, "50%") == err("format pattern '50%' ends with a lone '%'")
    assert strftime(f, "%z") == err("'%z' needs an offset, which a Date does not have")
