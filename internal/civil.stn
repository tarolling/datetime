// Calendar arithmetic on plain ints, in the proleptic Gregorian calendar with astronomical year
// numbering (year 0 is 1 BC). Days are counted from 1970-01-01, which is day 0. Every function
// here is total over the library's year range and never overflows.
//
// This module is internal to the datetime package. Its functions are `pub` only so `lib.stn` can
// call them; programs should use the types in `lib.stn` instead.

// The quotient of `a / b` rounded toward negative infinity, where stone's `/` truncates.
pub fn floor_div(a: int, b: int) -> int:
    q = a / b
    if a % b != 0 and (a < 0) != (b < 0):
        q -= 1
    ret q

// The remainder that goes with `floor_div`, which has the sign of `b`.
pub fn floor_mod(a: int, b: int) -> int:
    ret a - floor_div(a, b) * b

pub fn abs(a: int) -> int:
    if a < 0:
        ret -a
    ret a

pub fn is_leap_year(year: int) -> bool:
    ret floor_mod(year, 4) == 0 and (floor_mod(year, 100) != 0 or floor_mod(year, 400) == 0)

pub fn days_in_year(year: int) -> int:
    if is_leap_year(year):
        ret 366
    ret 365

// The number of days in `month` (1 to 12) of `year`, or 0 for a month out of range.
pub fn days_in_month(year: int, month: int) -> int:
    if month == 2:
        if is_leap_year(year):
            ret 29
        ret 28
    if month == 4 or month == 6 or month == 9 or month == 11:
        ret 30
    if month >= 1 and month <= 12:
        ret 31
    ret 0

// The days from 1970-01-01 to the given date, negative before it. The date must be valid.
// Howard Hinnant's `days_from_civil`, which counts in 400-year eras of 146097 days, each starting
// on March 1 so that the leap day falls at the end of a year.
pub fn days_from_civil(year: int, month: int, day: int) -> int:
    y = year
    if month <= 2:
        y -= 1
    era = floor_div(y, 400)
    yoe = y - era * 400
    mp = (month + 9) % 12
    doy = (153 * mp + 2) / 5 + day - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    ret era * 146097 + doe - 719468

// The (year, month, day) of the day `days` after 1970-01-01; the inverse of `days_from_civil`.
pub fn civil_from_days(days: int) -> tuple[int, int, int]:
    z = days + 719468
    era = floor_div(z, 146097)
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    day = doy - (153 * mp + 2) / 5 + 1
    month = mp - 9
    if mp < 10:
        month = mp + 3
    year = yoe + era * 400
    if month <= 2:
        year += 1
    ret (year, month, day)

// The ISO weekday of the day `days` after 1970-01-01: 1 for Monday through 7 for Sunday.
// 1970-01-01 was a Thursday.
pub fn weekday_from_days(days: int) -> int:
    ret floor_mod(days + 3, 7) + 1

// The day of the year, 1 for January 1. The date must be valid.
pub fn day_of_year(year: int, month: int, day: int) -> int:
    ret days_from_civil(year, month, day) - days_from_civil(year, 1, 1) + 1

// The number of ISO weeks in `year`: 53 if the year starts on a Thursday, or is a leap year that
// starts on a Wednesday, and 52 otherwise.
pub fn iso_weeks_in_year(year: int) -> int:
    jan1 = weekday_from_days(days_from_civil(year, 1, 1))
    if jan1 == 4 or (jan1 == 3 and is_leap_year(year)):
        ret 53
    ret 52

// The ISO 8601 (week-based year, week) of a date. Week 1 is the week with the year's first
// Thursday, so a few days at either end of a year belong to the week-based year next to it.
pub fn iso_week(year: int, month: int, day: int) -> tuple[int, int]:
    days = days_from_civil(year, month, day)
    week = (day_of_year(year, month, day) - weekday_from_days(days) + 10) / 7
    if week < 1:
        ret (year - 1, iso_weeks_in_year(year - 1))
    if week > iso_weeks_in_year(year):
        ret (year + 1, 1)
    ret (year, week)

// The days from 1970-01-01 to the `weekday` (1 to 7) of ISO week `week` of week-based year
// `iso_year`. The week must exist in that year.
pub fn days_from_iso_week(iso_year: int, week: int, weekday: int) -> int:
    jan4 = days_from_civil(iso_year, 1, 4)
    monday_of_week1 = jan4 - (weekday_from_days(jan4) - 1)
    ret monday_of_week1 + (week - 1) * 7 + (weekday - 1)

test "floor division and modulo round toward negative infinity":
    assert floor_div(7, 2) == 3
    assert floor_div(-7, 2) == -4
    assert floor_div(7, -2) == -4
    assert floor_div(-7, -2) == 3
    assert floor_div(-8, 2) == -4
    assert floor_mod(-7, 2) == 1
    assert floor_mod(7, -2) == -1
    assert floor_mod(-1, 86400) == 86399

test "leap years follow the Gregorian rule":
    assert is_leap_year(2024)
    assert is_leap_year(2000)
    assert not is_leap_year(1900)
    assert not is_leap_year(2026)
    assert is_leap_year(0)
    assert is_leap_year(-4)
    assert not is_leap_year(-100)
    assert is_leap_year(-400)
    assert days_in_year(2024) == 366
    assert days_in_month(2024, 2) == 29
    assert days_in_month(2023, 2) == 28
    assert days_in_month(2023, 4) == 30
    assert days_in_month(2023, 12) == 31
    assert days_in_month(2023, 13) == 0

test "days from civil matches known dates":
    assert days_from_civil(1970, 1, 1) == 0
    assert days_from_civil(1969, 12, 31) == -1
    assert days_from_civil(2000, 3, 1) == 11017
    assert days_from_civil(2026, 10, 8) == 20734
    assert days_from_civil(1, 1, 1) == -719162
    assert days_from_civil(0, 3, 1) == -719468
    assert days_from_civil(-1, 12, 31) == -719529

test "civil from days inverts days from civil":
    d = -800000
    while d <= 800000:
        y, m, day = civil_from_days(d)
        assert m >= 1 and m <= 12
        assert day >= 1 and day <= days_in_month(y, m)
        assert days_from_civil(y, m, day) == d
        d += 97

test "consecutive days advance the calendar by one":
    y, m, d = civil_from_days(-150000)
    for i in range(300000):
        ny, nm, nd = civil_from_days(-150000 + i + 1)
        if d < days_in_month(y, m):
            assert ny == y and nm == m and nd == d + 1
        elif m < 12:
            assert ny == y and nm == m + 1 and nd == 1
        else:
            assert ny == y + 1 and nm == 1 and nd == 1
        y = ny
        m = nm
        d = nd

test "the far ends of the year range convert both ways":
    lo = days_from_civil(-999999, 1, 1)
    hi = days_from_civil(999999, 12, 31)
    assert civil_from_days(lo) == (-999999, 1, 1)
    assert civil_from_days(hi) == (999999, 12, 31)

test "weekdays":
    assert weekday_from_days(0) == 4
    assert weekday_from_days(-1) == 3
    assert weekday_from_days(days_from_civil(2000, 3, 1)) == 3
    assert weekday_from_days(days_from_civil(2026, 11, 6)) == 5
    assert weekday_from_days(days_from_civil(1, 1, 1)) == 1

test "day of year":
    assert day_of_year(2026, 1, 1) == 1
    assert day_of_year(2026, 12, 31) == 365
    assert day_of_year(2024, 12, 31) == 366
    assert day_of_year(2024, 3, 1) == 61

test "ISO weeks at year boundaries":
    assert iso_week(2020, 12, 31) == (2020, 53)
    assert iso_week(2021, 1, 3) == (2020, 53)
    assert iso_week(2021, 1, 4) == (2021, 1)
    assert iso_week(2018, 12, 31) == (2019, 1)
    assert iso_week(2026, 11, 6) == (2026, 45)
    assert iso_week(2008, 12, 29) == (2009, 1)
    assert iso_week(2010, 1, 3) == (2009, 53)
    assert iso_weeks_in_year(2020) == 53
    assert iso_weeks_in_year(2015) == 53
    assert iso_weeks_in_year(2021) == 52

test "days from ISO week inverts ISO week":
    d = days_from_civil(1995, 1, 1)
    while d < days_from_civil(2030, 1, 1):
        y, m, day = civil_from_days(d)
        iy, w = iso_week(y, m, day)
        assert days_from_iso_week(iy, w, weekday_from_days(d)) == d
        d += 1

// `a + b`, or `none` if it does not fit in an int.
pub fn checked_add(a: int, b: int) -> option[int]:
    r = a + b
    if (a >= 0) == (b >= 0) and (r >= 0) != (a >= 0):
        ret none
    ret some(r)

// `a * b`, or `none` if it does not fit in an int.
pub fn checked_mul(a: int, b: int) -> option[int]:
    if a == 0 or b == 0:
        ret some(0)
    smallest = -9223372036854775807 - 1
    if a == -1:
        if b == smallest:
            ret none
        ret some(-b)
    if b == -1:
        if a == smallest:
            ret none
        ret some(-a)
    r = a * b
    if r / b != a:
        ret none
    ret some(r)

test "checked arithmetic":
    big = 9223372036854775807
    assert checked_add(1, 2) == some(3)
    assert checked_add(big, 1) == none
    assert checked_add(-big, -2) == none
    assert checked_add(big, -big) == some(0)
    assert checked_mul(3, -4) == some(-12)
    assert checked_mul(big, 2) == none
    assert checked_mul(-1, -big - 1) == none
    assert checked_mul(-big - 1, -1) == none
    assert checked_mul(4294967296, 4294967296) == none
    assert checked_mul(3037000499, 3037000499) == some(9223372030926249001)
